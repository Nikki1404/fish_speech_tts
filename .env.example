# Current official Fish Speech CUDA API image.
FISH_SPEECH_IMAGE=fishaudio/fish-speech:server-cuda

# Fish Audio S2 Pro model paths inside the Fish Speech container.
LLAMA_CHECKPOINT_PATH=checkpoints/s2-pro
DECODER_CHECKPOINT_PATH=checkpoints/s2-pro/codec.pth
DECODER_CONFIG_NAME=modded_dac_vq

# Enable torch.compile on CUDA. First synthesis will take longer while compiling.
COMPILE=1

# Public WebSocket gateway port.
GATEWAY_PORT=8880

# Optional gateway authentication. Leave blank for local testing.
WS_API_KEY=

# Gateway limits/timeouts.
MAX_TEXT_LENGTH=8000
UPSTREAM_CONNECT_TIMEOUT=30
UPSTREAM_READ_TIMEOUT=900
LOG_LEVEL=INFO
